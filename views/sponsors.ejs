<%- include('partials/header') %>

<div class="sheethead">
    <span class="code mono">SHEET 09</span>
    <h1>Sponsors</h1>
    <span class="kind mono">WHO BACKS THIS</span>
</div>

<p style="max-width: 600px; margin-bottom: 1.5rem; color: var(--body-text);">Sponsors fund prizes, production drawings, and physical builds. If you'd like to sponsor a challenge, get in touch.</p>

<div class="grid g2">
    <% sponsors.forEach(function(s) { %>
        <a href="<%= s.url %>" target="_blank" rel="noopener" class="card" style="text-decoration:none; color:inherit;">
            <h3><%= s.name %></h3>
            <p><%= s.blurb %></p>
        </a>
    <% }); %>
</div>

<%- include('partials/footer') %>
